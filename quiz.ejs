<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Timed Quiz</title>
    <style>
        body {
            font-family: 'Arial', sans-serif;
            line-height: 1.6;
            margin: 0;
            padding: 20px;
            background-color: #fff9e6; /* Light yellow background */
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            background: #ffffff;
            padding: 20px;
            border-radius: 8px;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.2);
        }

        h1 {
            color: #333;
            text-align: center;
            margin-bottom: 20px;
        }

        /* Circular Timer Styles */
        #timer {
            position: relative;
            width: 150px;
            height: 150px;
            margin: 0 auto;
            border-radius: 50%;
            overflow: hidden;
        }

        .circle {
            position: absolute;
            top: 50%;
            left: 50%;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: #fff;
            clip-path: circle(50%);
        }

        .mask {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: #ffcc00; /* Yellow for remaining time */
            clip-path: inset(0 0 50% 0);
            animation: rotate 60s linear forwards; /* 60 seconds rotation */
        }

        @keyframes rotate {
            from {
                transform: rotate(0deg);
            }
            to {
                transform: rotate(360deg);
            }
        }

        #time {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            font-weight: bold;
            font-size: 24px;
            z-index: 1; /* Above the circular elements */
        }

        .question {
            margin-bottom: 30px;
            padding: 20px;
            border: 1px solid #ddd;
            border-radius: 8px;
            background-color: #fff4cc; /* Light yellow background for questions */
        }

        .options {
            list-style-type: none;
            padding: 0;
            margin: 10px 0;
        }

        .options li {
            margin-bottom: 10px;
        }

        .options input[type="radio"] {
            display: none; /* Hide the default radio button */
        }

        .options label {
            display: flex;
            align-items: center;
            padding: 12px;
            background-color: #f9e2a3; /* Slightly darker yellow */
            border: 2px solid transparent;
            border-radius: 8px;
            cursor: pointer;
            transition: background-color 0.2s ease, border-color 0.2s ease;
            position: relative; /* For positioning the custom radio */
        }

        /* Custom radio button */
        .options label::before {
            content: '';
            display: inline-block;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            border: 2px solid #ffcc00; /* Border color for unselected radio */
            margin-right: 10px;
            transition: background-color 0.2s ease, transform 0.2s ease;
        }

        .options input[type="radio"]:checked + label::before {
            background-color: #ffcc00; /* Selected radio background */
            transform: scale(1.1); /* Slightly grow on selection */
        }

        .options input[type="radio"]:checked + label {
            background-color: #ffe89b; /* Light yellow when selected */
            border-color: #ffcc00; /* Yellow border for selected option */
        }

        .options label:hover {
            background-color: #ffe89b; /* Light hover effect */
        }

        button {
            display: block;
            width: 100%;
            padding: 12px;
            background-color: #ffcc00; /* Yellow button */
            color: #333;
            border: none;
            border-radius: 8px;
            font-size: 16px;
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

        button:hover {
            background-color: #e6b800; /* Darker yellow on hover */
        }

        .progress-bar {
            width: 100%;
            background-color: #f4f4f4;
            margin-bottom: 20px;
            border-radius: 10px;
            overflow: hidden;
        }

        .progress {
            height: 10px;
            background-color: #ffcc00; /* Yellow progress bar */
            width: 0;
            transition: width 1s linear; /* Animate progress */
        }

        .correct {
            background-color: #d4edda !important;
            border-color: #28a745 !important;
        }

        .incorrect {
            background-color: #f8d7da !important;
            border-color: #dc3545 !important;
        }

        .score {
            font-size: 24px;
            font-weight: bold;
            text-align: center;
            margin-top: 20px;
            color: #333;
        }
    </style>
</head>

<body>
    <div class="container">
        <h1>Timed Quiz</h1>
        <div id="timer">
            <div class="mask"></div>
            <div class="circle"></div>
            <div id="time">0:00</div>
        </div>

        <div class="progress-bar">
            <div class="progress" id="progress"></div>
        </div>

        <div id="quiz-container">
            <% quiz.forEach((question, index) => { %>
                <div class="question" data-index="<%= index %>">
                    <h3>Question <%= index + 1 %></h3>
                    <p><%= question.question %></p>
                    <ul class="options">
                        <% question.options.forEach((option) => { %>
                            <li>
                                <input type="radio" id="q<%= index %>-<%= option %>" name="q<%= index %>" value="<%= option %>">
                                <label for="q<%= index %>-<%= option %>"><%= option %></label>
                            </li>
                        <% }); %>
                    </ul>
                </div>
            <% }); %>
        </div>
        <button id="submit-btn" onclick="submitQuiz()">Submit Quiz</button>

        <div id="score" class="score" style="display:none;"></div>
    </div>

    <script>
        const quiz = <%- JSON.stringify(quiz) %>; // Assuming quiz data is passed from the server
        const quizTime = quiz.length * 60; // 1 minute per question
        let timeLeft = quizTime;
        let timerInterval = setInterval(updateTimer, 1000);
        let score = 0;

        document.getElementById("time").innerHTML = formatTime(quizTime);

        function updateTimer() {
            timeLeft--;
            document.getElementById("time").innerHTML = formatTime(timeLeft);

            const progressBar = document.getElementById("progress");
            progressBar.style.width = ((quizTime - timeLeft) / quizTime) * 100 + "%";

            if (timeLeft <= 0) {
                clearInterval(timerInterval);
                submitQuiz();
            }
        }

        function formatTime(seconds) {
            const minutes = Math.floor(seconds / 60);
            const remainingSeconds = seconds % 60;
            return `${minutes}:${remainingSeconds < 10 ? "0" : ""}${remainingSeconds}`;
        }

        function submitQuiz() {
            clearInterval(timerInterval);
            score = 0;
            const questions = document.querySelectorAll('.question');

            questions.forEach((question, index) => {
                const selectedOption = document.querySelector(`input[name="q${index}"]:checked`);
                const correctAnswer = quiz[index].answer;

                if (selectedOption) {
                    if (selectedOption.value === correctAnswer) {
                        selectedOption.parentElement.querySelector('label').classList.add('correct');
                        score++;
                    } else {
                        selectedOption.parentElement.querySelector('label').classList.add('incorrect');
                        // Highlight the correct answer
                        question.querySelector(`input[value="${correctAnswer}"]`).parentElement.querySelector('label').classList.add('correct');
                    }
                } else {
                    // If no answer selected, highlight the correct one
                    question.querySelector(`input[value="${correctAnswer}"]`).parentElement.querySelector('label').classList.add('correct');
                }

                // Disable all inputs after submission
                question.querySelectorAll('input[type="radio"]').forEach(input => input.disabled = true);
            });

            const scoreDisplay = document.getElementById("score");
            scoreDisplay.style.display = "block";
            scoreDisplay.innerHTML = `Your score: ${score}/${quiz.length}`;
        }
    </script>
</body>

</html>
